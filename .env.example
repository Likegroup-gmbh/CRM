# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration  
VITE_APP_NAME="CRM Dashboard"
VITE_APP_VERSION="2.0.0"
# Parallelbetrieb: leer = v1, v2 = Badge an (Worktree CRM-v2 / Netlify context.v2)
VITE_APP_CHANNEL=

# Dropbox API (for video uploads)
DROPBOX_REFRESH_TOKEN=your-refresh-token-here
DROPBOX_APP_KEY=your-app-key-here
DROPBOX_APP_SECRET=your-app-secret-here

# Medienablage-Schalter Videos-Tab: on = Dropbox, off = SharePoint-Weg. Leer = src/core/ablage/schalter.json.
# Wird in den Build eingebacken UND von den Functions gelesen: in Netlify Scope "All" (Builds + Functions).
VITE_DROPBOX_UPLOAD=

# Cloudflare Workers AI (Whisper-Transkription, _shared/video-transcribe.js)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Meta Graph API (Instagram Connect im Creator-Aktionsmenue, Function instagram-connect)
# META_ACCESS_TOKEN: Long-Lived User Token (60 Tage!) mit instagram_basic,
#   instagram_manage_insights, pages_read_engagement, ads_read, pages_show_list.
#   Kurzlebige Explorer-Tokens vorher via fb_exchange_token tauschen.
# META_IG_USER_ID: eigene Instagram-Business-Account-ID (Caller fuer Business Discovery)
META_ACCESS_TOKEN=your-long-lived-meta-token-here
META_IG_USER_ID=17841458145051730
# Optional, Default v21.0
META_GRAPH_VERSION=v21.0
