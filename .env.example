# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration  
VITE_APP_NAME="CRM Dashboard"
VITE_APP_VERSION="2.0.0"
# Parallelbetrieb: leer = v1, v2 = v2-Kanal (Worktree CRM-v2 / Netlify context.v2)
VITE_APP_CHANNEL=
# v2-Badge oben rechts: on|off übersteuert src/core/parallelbetrieb/schalter.json (Standard: aus)
VITE_CHANNEL_BADGE=

# Cloudflare Workers AI (Whisper-Transkription, _shared/video-transcribe.js)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Meta Graph API (Instagram Connect im Creator-Aktionsmenue, Function instagram-connect)
# META_ACCESS_TOKEN: Long-Lived User Token (60 Tage!) mit instagram_basic,
#   instagram_manage_insights, pages_read_engagement, ads_read, pages_show_list.
#   Kurzlebige Explorer-Tokens vorher via fb_exchange_token tauschen.
# META_IG_USER_ID: eigene Instagram-Business-Account-ID (Caller fuer Business Discovery)
META_ACCESS_TOKEN=your-long-lived-meta-token-here
META_IG_USER_ID=17841458145051730
# Optional, Default v21.0
META_GRAPH_VERSION=v21.0

# Apify TikTok-Scraper (Admin-Seite /admin/tiktok-api, Function tiktok-scraper)
# APIFY_TOKEN: Apify Console > Settings > API & Integrations > Personal API token
APIFY_TOKEN=
# Optional, Default clockworks~tiktok-scraper
APIFY_TIKTOK_ACTOR=
# Optional, Default apify~instagram-reel-scraper (Admin-Seite /admin/instagram-cpm,
# Functions instagram-reels-scraper und instagram-bild; gleicher APIFY_TOKEN)
APIFY_INSTAGRAM_ACTOR=
# Optional: Kostendeckel pro Lauf in USD, Default 0.5
APIFY_MAX_USD=
